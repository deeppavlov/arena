ARENA_PUBLIC_WORKSPACE=/srv/arena/public
ARENA_PUBLIC_MLFLOW_URL=http://gpu6:5050
ARENA_DATASET_PATH=/srv/arena/private/dataset.jsonl
ARENA_METRIC_PATH=/srv/arena/private/metric.json
ARENA_STATE_DIR=/srv/arena/state
ARENA_ASSETS_DIR=/srv/arena/assets
ARENA_SUBMIT_TOKEN_FILE=/srv/arena/secrets/submit-token
ARENA_MODEL_API_KEY_FILE=/srv/arena/secrets/model-api-key
ARENA_MODEL=internal-model
ARENA_MODEL_BASE_URL=http://internal-model.invalid/v1
ARENA_PARAMETERS={"temperature":0,"max_tokens":4096}
ARENA_RUNNER_IMAGE=unset
ARENA_RUNNER_NETWORK=arena-runners
ARENA_RELEASE_ID=replace-with-frozen-release-id
ARENA_FINALISTS=5
ARENA_EVALUATOR_PORT=8080
ARENA_DOCKER_SOCKET=/var/run/docker.sock
ARENA_DOCKER_GID=999
